+const PERF_TRACE_THRESHOLD: std::time::Duration = std::time::Duration::from_millis(25);
+
+pub fn perf_trace_threshold() -> std::time::Duration {
+    PERF_TRACE_THRESHOLD
+}
+
+pub fn perf_trace_enabled() -> bool {
+    static ENABLED: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ENABLED.get_or_init(|| std::env::var("ROSEMARY_PERF_TRACE").ok().as_deref() == Some("1"))
+}
+
+pub type PerfTracePcMapper = fn(u64) -> Option<String>;
+
+static PERF_TRACE_PC_MAPPER: std::sync::OnceLock<PerfTracePcMapper> = std::sync::OnceLock::new();
+
+pub fn set_perf_trace_pc_mapper(mapper: PerfTracePcMapper) {
+    let _ = PERF_TRACE_PC_MAPPER.set(mapper);
+}
+
+pub fn perf_trace_map_pc(pc: u64) -> Option<String> {
+    PERF_TRACE_PC_MAPPER.get().and_then(|mapper| mapper(pc))
+}
+
+pub fn perf_trace_start() -> Option<std::time::Instant> {
+    perf_trace_enabled().then(std::time::Instant::now)
+}
+
+pub fn perf_trace_log(message: &str) {
+    if perf_trace_enabled() {
+        static ORIGIN: std::sync::OnceLock<std::time::Instant> = std::sync::OnceLock::new();
+        let elapsed_ms = ORIGIN
+            .get_or_init(std::time::Instant::now)
+            .elapsed()
+            .as_secs_f64()
+            * 1000.0;
+        eprintln!("rosemary: perf: at_ms={elapsed_ms:.3} {message}");
+    }
+}
+
+pub fn perf_trace_duration(stage: &str, duration: std::time::Duration) {
+    if perf_trace_enabled() && duration >= PERF_TRACE_THRESHOLD {
+        perf_trace_log(&format!(
+            "stage={stage} duration_ms={:.3}",
+            duration.as_secs_f64() * 1000.0
+        ));
+    }
+}
+
+pub fn perf_trace_duration_with_context(stage: &str, duration: std::time::Duration, context: &str) {
+    if perf_trace_enabled() && duration >= PERF_TRACE_THRESHOLD {
+        perf_trace_log(&format!(
+            "stage={stage} duration_ms={:.3} {context}",
+            duration.as_secs_f64() * 1000.0
+        ));
+    }
+}
+
+pub fn perf_trace_record(stage: &str, start: Option<std::time::Instant>) {
+    if let Some(start) = start {
+        perf_trace_duration(stage, start.elapsed());
+    }
+}
