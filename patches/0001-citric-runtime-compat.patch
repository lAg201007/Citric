+        let picker = FilePicker {
+            entries: vec![
+                Entry {
+                    name: "folder".into(),
+                    directory: true,
+                },
+                Entry {
+                    name: "place.rbxl".into(),
+                    directory: false,
+                },
+            ],
+            ..FilePicker::default()
+        };
+        let layout = picker.layout(Rect::new(0.0, 0.0, 720.0, 500.0), &Theme::light());
+        assert_eq!(
+            picker.hit(&layout, layout.rows[1].1.center()),
