+            continue;
+        };
+        if let Some(answer) = handle(&event) {
+            break (answer, false);
+        }
+        match event {
+            Event::Quit => break (dismissed.clone(), true),
+            Event::Key { .. }
+            | Event::Text { .. }
+            | Event::TextEditing { .. }
+            | Event::MouseMotion { .. }
+            | Event::MouseButton { .. }
+            | Event::MouseWheel { .. }
+            | Event::WindowClosed { .. }
+            | Event::WindowHitTest { .. } => {}
+            other => crate::event::deliver_past_modal(other),
+        }
+    };
+    MODAL.set(outer);
