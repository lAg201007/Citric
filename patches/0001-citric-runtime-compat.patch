+    static LATE_POOL_TOKEN: AtomicUsize = AtomicUsize::new(usize::MAX);
+
+    struct PushAfterPoolDestruction;
+
+    impl Drop for PushAfterPoolDestruction {
+        fn drop(&mut self) {
+            let token = pool_push();
+            LATE_POOL_TOKEN.store(token as usize, Ordering::SeqCst);
+            pool_pop(token);
+        }
+    }
+
+    thread_local! {
+        static PUSH_AFTER_POOL_DESTRUCTION: PushAfterPoolDestruction = const { PushAfterPoolDestruction };
+    }
+
+    #[test]
+    fn pool_access_after_thread_local_destruction_is_safe() {
+        LATE_POOL_TOKEN.store(usize::MAX, Ordering::SeqCst);
+        std::thread::spawn(|| {
+            PUSH_AFTER_POOL_DESTRUCTION.with(|_| {});
+            assert!(!pool_push().is_null());
+        })
+        .join()
+        .unwrap();
+        assert_eq!(LATE_POOL_TOKEN.load(Ordering::SeqCst), 0);
+    }
