+        let get_accessory = objc::sel::get("accessoryView");
+
+        unsafe {
+            setter(panel, set_accessory, first);
+            assert_eq!(objc::arc::retain_count(first), 2);
+            assert_eq!(getter(panel, get_accessory), first);
+
+            setter(panel, set_accessory, second);
