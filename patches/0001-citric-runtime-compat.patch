+pub(crate) fn with_current_event<R>(event: Id, body: impl FnOnce() -> R) -> R {
+    struct Restore(Id);
+
+    impl Drop for Restore {
+        fn drop(&mut self) {
+            CURRENT_EVENT.store(self.0 as usize, Ordering::Release);
+        }
+    }
+
+    let previous = CURRENT_EVENT.swap(event as usize, Ordering::AcqRel) as Id;
+    let restore = Restore(previous);
+    let result = body();
+    drop(restore);
+    result
+}
