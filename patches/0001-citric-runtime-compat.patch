+pub fn describe_host_pc(return_pc: u64) -> Option<String> {
+    let previous = {
+        #[cfg(target_arch = "x86_64")]
+        {
+            return_pc.checked_sub(1)
+        }
+        #[cfg(target_arch = "aarch64")]
+        {
+            return_pc.checked_sub(4)
+        }
+        #[cfg(not(any(target_arch = "x86_64", target_arch = "aarch64")))]
+        {
+            None
+        }
+    };
+    let mut translated = None;
+    for pc in std::iter::once(return_pc).chain(previous) {
+        match attribute(pc) {
+            Attribution::Instruction { guest_va, region } => {
+                let image = crate::thunk::current()
+                    .and_then(|vm| vm.program.locate(guest_va))
+                    .unwrap_or_else(|| String::from("unknown"));
+                return Some(format!(
+                    "mapped_pc={pc:#x},guest={guest_va:#x},region={region:#x},image={image}"
+                ));
+            }
+            Attribution::Translated { region, why } => {
+                translated.get_or_insert_with(|| {
+                    format!("mapped_pc={pc:#x},translated_region={region:#x},kind={why:?}")
+                });
+            }
+            Attribution::Elsewhere => {}
+        }
+    }
+    translated
+}
