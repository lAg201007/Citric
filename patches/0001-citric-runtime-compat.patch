+    let patterns: Vec<String> = extensions
+        .iter()
+        .map(|extension| format!("*.{extension}"))
+        .collect();
+    let label = format!("Supported files ({})", patterns.join(", "));
+    let mut filter = FileFilter::new(&label);
+    for pattern in patterns {
+        filter = filter.glob(&pattern);
+    }
+    vec![filter]
