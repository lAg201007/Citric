+/// Report a selected call from one guest image into another.
+///
+/// These calls transfer directly back into guest code and do not pass through
+/// `abi::call_planned`, where ordinary import traces are emitted. Recording the
+/// target here lets a focused trace follow calls from a platform plugin into Qt.
+pub fn entering_guest(symbol: &str, target: u64, ctx: &RegisterContext, event_type: Option<u16>) {
+    eprintln!(
+        "rosemary: guest call [{:#x}] at {:#x} {symbol} -> {target:#x}({:#x}, {:#x}, {:#x}, {:#x}) event_type={event_type:?}",
+        thread_id(),
+        ctx.rip,
+        ctx.rdi,
+        ctx.rsi,
+        ctx.rdx,
+        ctx.rcx,
+    );
+}
+
 /// This thread, as a number small enough to read across a log.
