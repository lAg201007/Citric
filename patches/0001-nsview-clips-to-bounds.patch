+pub(crate) fn clips_to_bounds_of(receiver: Id) -> bool {
+    let clipping = view_of(receiver).clipping;
+    if clipping & CLIPPING_EXPLICIT != 0 {
+        return clipping & CLIPPING_ENABLED != 0;
+    }
+    unsafe { objc::object::class_of(receiver) }.is_some_and(|class| {
+        class
+            .chain()
+            .any(|ancestor| ancestor.name_str() == "NSClipView")
+    })
+}
+
+unsafe extern "C" fn clips_to_bounds(receiver: Id, _sel: Sel) -> u8 {
+    u8::from(clips_to_bounds_of(receiver))
+}
+
+unsafe extern "C" fn set_clips_to_bounds(receiver: Id, _sel: Sel, clips: u8) {
+    view_of(receiver).clipping = CLIPPING_EXPLICIT | u8::from(clips != 0);
+    crate::backing::needs_display(receiver);
+}
+
+fn intersect_rects(first: NSRect, second: NSRect) -> NSRect {
+    let x = first.origin.x.max(second.origin.x);
+    let y = first.origin.y.max(second.origin.y);
+    let right = (first.origin.x + first.size.width).min(second.origin.x + second.size.width);
+    let top = (first.origin.y + first.size.height).min(second.origin.y + second.size.height);
+    NSRect {
+        origin: NSPoint { x, y },
+        size: NSSize {
+            width: (right - x).max(0.0),
+            height: (top - y).max(0.0),
+        },
+    }
+}
+
+unsafe extern "C" fn visible_rect(receiver: Id, _sel: Sel) -> NSRect {
+    if is_hidden_or_has_hidden_ancestor(receiver) {
+        return NSRect::default();
