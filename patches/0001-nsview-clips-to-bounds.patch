+    } else {
+        convert_rect(bounds_of(root), root, receiver)
+    };
+    for ancestor in chain {
+        if clips_to_bounds_of(ancestor) {
+            visible = intersect_rects(
+                visible,
+                convert_rect(bounds_of(ancestor), ancestor, receiver),
