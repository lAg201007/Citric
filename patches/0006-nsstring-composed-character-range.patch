+    #[test]
+    fn composed_ranges_cover_every_utf16_unit_of_extended_graphemes() {
+        // Include boundaries before and after the cluster to detect byte or
+        // Unicode-scalar offsets being mistaken for NSString's UTF-16 indexes.
+        for cluster in ["a", "e\u{301}", "😀", "👍🏽", "👩‍💻", "🇧🇷", "\r\n", "각"]
+        {
+            let text = format!("x{cluster}y");
+            let units: Vec<_> = text.encode_utf16().collect();
+            let width = cluster.encode_utf16().count();
+            assert_eq!(
+                composed_character_range(&units, 0),
+                Some(NSRange {
+                    location: 0,
+                    length: 1
+                })
+            );
+            for index in 1..=width {
+                assert_eq!(
+                    composed_character_range(&units, index),
+                    Some(NSRange {
+                        location: 1,
+                        length: width
+                    }),
+                    "{cluster:?}, UTF-16 index {index}"
+                );
+            }
+            assert_eq!(
+                composed_character_range(&units, width + 1),
+                Some(NSRange {
+                    location: width + 1,
+                    length: 1
+                })
+            );
+        }
+    }
+
+    #[test]
+    fn composed_ranges_reject_invalid_indices_and_preserve_unpaired_surrogate_offsets() {
+        assert_eq!(composed_character_range(&[], 0), None);
+        let units = [0xd800, b'a' as u16, 0xdc00, b'b' as u16];
+        for index in 0..units.len() {
+            assert_eq!(
+                composed_character_range(&units, index),
+                Some(NSRange {
+                    location: index,
+                    length: 1
+                })
+            );
+        }
+        assert_eq!(composed_character_range(&units, units.len()), None);
+        assert_eq!(composed_character_range(&units, usize::MAX), None);
+    }
