+/// Locate an extended grapheme cluster in NSString's UTF-16 coordinate space.
+/// Lossy decoding is used only for boundary analysis: each isolated surrogate
+/// becomes one replacement scalar, preserving the original UTF-16 offsets.
+/// The receiver's contents are never normalized or replaced.
+fn composed_character_range(units: &[u16], index: usize) -> Option<NSRange> {
+    use unicode_segmentation::UnicodeSegmentation;
+
+    if index >= units.len() {
+        return None;
+    }
+    let text = String::from_utf16_lossy(units);
+    let mut location = 0;
+    for grapheme in text.graphemes(true) {
+        let length = grapheme.encode_utf16().count();
+        if index < location + length {
+            return Some(NSRange { location, length });
+        }
+        location += length;
+    }
+    None
+}
+
+unsafe extern "C" fn range_of_composed_character_at_index(
+    receiver: Id,
+    _sel: Sel,
+    index: usize,
+) -> NSRange {
+    // SAFETY: the receiver is an NSString; all indexes count UTF-16 units.
+    let units = unsafe { units(receiver) };
+    composed_character_range(&units, index).unwrap_or_else(|| {
+        objc::fail!(
+            "-[NSString rangeOfComposedCharacterSequenceAtIndex:]: NSRangeException: index {index} outside length {}",
+            units.len(),
+        )
+    })
+}
+
 unsafe extern "C" fn character_at_index(receiver: Id, _sel: Sel, index: usize) -> u16 {
