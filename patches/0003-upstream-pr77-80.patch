+) -> i32 {
+    if collator.is_null() {
+        return PARAM_ERR;
+    }
+    // SAFETY: the caller's out-parameter; [`UCDisposeCollator`] frees it.
+    unsafe { *collator = Box::into_raw(Box::new(Collator { options })).cast() };
