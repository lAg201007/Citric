+fn compare(a: &[char], b: &[char], options: u32) -> Ordering {
+    let primary = tokens(a, options, true).cmp(&tokens(b, options, true));
+    if primary != Ordering::Equal || options & CASE_INSENSITIVE != 0 {
+        return primary;
+    }
+    let case = |text: &[char]| -> Vec<bool> {
