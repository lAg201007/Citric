+/// NSObject's instance description includes the dynamic class and identity.
+/// Build a Foundation string here instead of making the Objective-C runtime
+/// depend on Foundation or returning a borrowed buffer to the guest.
+unsafe extern "C" fn object_description(receiver: Id, _sel: Sel) -> Id {
+    // SAFETY: a message receiver is a live object.
+    let name = unsafe { objc::object::class_of(receiver) }
+        .map_or("NSObject", objc::class::Class::name_str);
+    autoreleased(&format!("<{name}: {receiver:p}>"))
+}
+
+/// NSObject's class description is the receiving class's name, not its
+/// metaclass's address and not an instance-style description.
+unsafe extern "C" fn class_description(receiver: Id, _sel: Sel) -> Id {
+    // SAFETY: a class-method receiver is a registered class object.
+    let name = unsafe { objc::class::from_ptr(receiver.cast()) }
+        .map_or("NSObject", objc::class::Class::name_str);
+    autoreleased(name)
+}
+
+/// The default debug description delegates to the receiver's description so
+/// subclass overrides also apply when the debugger or a logger asks for it.
+unsafe extern "C" fn debug_description(receiver: Id, _sel: Sel) -> Id {
+    // SAFETY: both the instance and class selectors return an NSString object.
+    let send: unsafe extern "C" fn(Id, Sel) -> Id =
+        unsafe { std::mem::transmute(objc::msg::entry()) };
+    unsafe { send(receiver, objc::sel::get("description")) }
+}
+
