+#[cfg(test)]
+mod trace_tests {
+    use super::*;
+    use std::ffi::c_void;
+
+    const CHILD: &str = "ROSEMARY_OBJC_TRACE_TEST_CHILD";
+
+    unsafe extern "C" fn selected_method(_receiver: Id, _sel: Sel) -> usize {
+        17
+    }
+
+    unsafe extern "C" fn unselected_method(_receiver: Id, _sel: Sel) -> usize {
+        23
+    }
+
+    #[test]
+    fn selected_message_trace_records_dispatch_metadata() {
+        if std::env::var_os(CHILD).is_some() {
+            crate::bootstrap();
+            let superclass = crate::class::lookup(c"NSObject").expect("NSObject");
+            let class =
+                crate::class::allocate_pair(Some(superclass), c"RosemaryMessageTraceProbe", 0)
+                    .expect("unique trace test class");
+            crate::class::register_pair(class);
+            let selected = crate::sel::get("traceSelected");
+            let unselected = crate::sel::get("traceUnselected");
+            assert!(class.add_method(selected, selected_method as *const c_void, c"Q16@0:8",));
+            assert!(class.add_method(unselected, unselected_method as *const c_void, c"Q16@0:8",));
+            let object = crate::object::create_instance(class, 0);
+            let send: unsafe extern "C" fn(Id, Sel) -> usize =
+                unsafe { std::mem::transmute(entry()) };
+            assert_eq!(unsafe { send(object, selected) }, 17);
+            assert_eq!(unsafe { send(object, unselected) }, 23);
+            crate::arc::release(object);
+            return;
+        }
+
+        let path = std::env::temp_dir().join(format!(
+            "rosemary-objc-trace-{}-{}.log",
+            std::process::id(),
+            std::time::SystemTime::now()
+                .duration_since(std::time::UNIX_EPOCH)
+                .expect("clock after epoch")
+                .as_nanos(),
+        ));
+        std::fs::File::create(&path).expect("precreate trace file");
+        let output = std::process::Command::new(std::env::current_exe().expect("test executable"))
+            .args([
+                "--exact",
+                "msg::trace_tests::selected_message_trace_records_dispatch_metadata",
+                "--nocapture",
+            ])
+            .env(CHILD, "1")
+            .env("ROSEMARY_OBJC_TRACE_LOG", &path)
+            .env("ROSEMARY_OBJC_TRACE_SELECTORS", "traceSelected")
+            .output()
+            .expect("run isolated trace child");
+        let stderr = String::from_utf8_lossy(&output.stderr);
+        assert!(output.status.success(), "child failed: {stderr}");
+        let contents = std::fs::read_to_string(&path).expect("read trace");
+        let _ = std::fs::remove_file(&path);
+        let lines = contents.lines().collect::<Vec<_>>();
+        assert_eq!(lines.len(), 1, "unexpected trace records: {contents}");
+        let line = lines[0];
+        assert!(line.contains("objc_message t_us="), "{line}");
+        assert!(line.contains("thread=ThreadId("), "{line}");
+        assert!(line.contains("class=RosemaryMessageTraceProbe"), "{line}");
+        assert!(
+            line.contains("method_owner=RosemaryMessageTraceProbe"),
+            "{line}"
+        );
+        assert!(line.contains("selector=traceSelected"), "{line}");
+        assert!(line.contains("imp=0x"), "{line}");
+        assert!(!line.contains("traceUnselected"), "{line}");
+    }
+}
