+/// Developer-only message tracing. Selector identities are resolved once and
+/// compared without formatting or opening a file during ordinary dispatch.
+/// No guest arguments or object contents are read by this observer.
+fn trace_selected_message(
+    receiver: Id,
+    sel: Sel,
+    class: &'static crate::class::Class,
+    method: Option<&'static crate::class::Method>,
+) {
+    struct Config {
+        selectors: std::collections::HashSet<usize>,
+        started: std::time::Instant,
+        writer: std::sync::Mutex<std::fs::File>,
+    }
+    static CONFIG: std::sync::OnceLock<Option<Config>> = std::sync::OnceLock::new();
+    let Some(config) = CONFIG.get_or_init(|| {
+        let path = std::env::var_os("ROSEMARY_OBJC_TRACE_LOG")?;
+        let names = std::env::var("ROSEMARY_OBJC_TRACE_SELECTORS").ok()?;
+        let selectors = names
+            .split(',')
+            .map(str::trim)
+            .filter(|s| !s.is_empty())
+            .filter(|name| !name.as_bytes().contains(&0))
+            .map(|name| crate::sel::get(name) as usize)
+            .collect::<std::collections::HashSet<_>>();
+        if selectors.is_empty() {
+            return None;
+        }
+        let writer = std::fs::OpenOptions::new().append(true).open(path).ok()?;
+        Some(Config {
+            selectors,
+            started: std::time::Instant::now(),
+            writer: std::sync::Mutex::new(writer),
+        })
+    }) else {
+        return;
+    };
+    if !config.selectors.contains(&(sel as usize)) {
+        return;
+    }
+    // SAFETY: only a registered selector from Config can reach this point.
+    let name = unsafe { std::ffi::CStr::from_ptr(crate::sel::name(sel)) };
+    use std::io::Write;
+    let (imp, method_owner) = method.map_or((std::ptr::null(), "<unrecognized>"), |method| {
+        let owner = class
+            .chain()
+            .find(|candidate| candidate.own_method(sel).is_some())
+            .map_or("<unknown>", |candidate| candidate.name_str());
+        (method.implementation(), owner)
+    });
+    let line = format!(
+        "objc_message t_us={} thread={:?} receiver={receiver:p} class={} method_owner={method_owner} selector={} imp={imp:p}\n",
+        config.started.elapsed().as_micros(),
+        std::thread::current().id(),
+        class.name_str(),
+        name.to_string_lossy(),
+    );
+    let mut writer = config
+        .writer
+        .lock()
+        .unwrap_or_else(|error| error.into_inner());
+    let _ = writer.write_all(line.as_bytes());
+}
